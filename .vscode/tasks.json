{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "uni-app serve",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev:h5"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": ".*"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": ".*listening on.*"
        }
      }
    }
  ]
}